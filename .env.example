# Supabase — obter em https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Personal Access Token — usado por scripts/apply-migration-*.mjs (Management API). Opcional no dia a dia.
SUPABASE_PAT=<supabase-personal-access-token>
# Origens extras liberadas no CSP (img-src/connect-src), separadas por vírgula. Só na transição
# entre projetos Supabase, enquanto imagem_url no banco ainda apontar para o Storage antigo.
NEXT_PUBLIC_CSP_EXTRA_ORIGINS=
# Projeto Supabase ANTIGO — só para supabase/scripts/migracao-raiz/*.mjs (o app não lê).
OLD_SUPABASE_URL=https://<project-id-antigo>.supabase.co
OLD_SUPABASE_SERVICE_ROLE_KEY=<service-role-key-antiga>

# Google OAuth — obter em https://console.cloud.google.com (APIs & Services > Credentials)
# Redirect URIs: <APP_URL>/auth/callback (staff) e <APP_URL>/api/auth/google/callback (aluno)
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# Assinatura do cookie de sessão do aluno (HMAC-SHA256) — gere com: openssl rand -base64 32
# NÃO reutilizar a service_role key aqui (ver histórico de segurança no ONBOARDING.md)
SESSION_SIGNING_SECRET=<random-32-bytes-base64>

# Chave-mestra das credenciais de integração guardadas no banco (tabela credencial, AES-256-GCM).
# 32 bytes em base64 — gere com: openssl rand -base64 32. Guardar também no cofre da equipe.
# Sem ela, o app deriva uma chave PROVISÓRIA de SESSION_SIGNING_SECRET (HKDF); sem nenhuma das duas,
# a tela /configuracoes/credenciais só lê e o servidor usa as env vars abaixo como fallback.
CREDENCIAIS_MASTER_KEY=<random-32-bytes-base64>

# OpenAI — avaliação das questões discursivas (texto e visão). Preferir gravar em
# /configuracoes/credenciais; a env var é fallback. Obter em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-<key>

# Groq — provedor anterior das discursivas (reserva). Idem: tela primeiro, env como fallback.
GROQ_API_KEY=gsk_<key>

# Resend — obter em https://resend.com/api-keys
RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=olimpiadas@raizeducacao.com.br

# Sentry — obter em https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
SENTRY_AUTH_TOKEN=<auth-token>
SENTRY_ORG=raiz-educacao
SENTRY_PROJECT=olimpiadas-raiz

# Integração raiz-data-engine (sincronização de dados da rede) — opcional em dev local
RAIZ_DATA_ENGINE_URL=<url-do-serviço>
RAIZ_DATA_ENGINE_TOKEN=<token>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
